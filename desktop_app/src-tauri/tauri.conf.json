{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PerlerDrawing Desktop",
  "version": "0.1.0",
  "identifier": "io.perlerdrawing.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PerlerDrawing Desktop",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 680,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../python/sidecar.py": "python/sidecar.py",
      "../python/perlerdrawing_sidecar/__init__.py": "python/perlerdrawing_sidecar/__init__.py",
      "../python/perlerdrawing_sidecar/color.py": "python/perlerdrawing_sidecar/color.py",
      "../python/perlerdrawing_sidecar/exporter.py": "python/perlerdrawing_sidecar/exporter.py",
      "../python/perlerdrawing_sidecar/imaging.py": "python/perlerdrawing_sidecar/imaging.py",
      "../python/perlerdrawing_sidecar/protocol.py": "python/perlerdrawing_sidecar/protocol.py"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
